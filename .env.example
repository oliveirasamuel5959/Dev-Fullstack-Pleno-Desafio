# Template — copie para .env e ajuste se necessario.
# Fonte unica de configuracao; docker compose le este arquivo automaticamente.
#
# ── TimescaleDB ──────────────────────────────────────────────────────────
# Componentes separados para permitir construcao da URL em diferentes contextos
# (localhost para dev local, timescaledb para dentro do container Docker).
POSTGRES_USER=oee
POSTGRES_PASSWORD=oee_dev
POSTGRES_DB=oee_textil

# URL completa para uso local (fora do container); dentro do container o
# docker compose constroi com host=timescaledb a partir dos componentes acima.
DATABASE_URL=postgresql://oee:oee_dev@localhost:5432/oee_textil

#
# ── MQTT ─────────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
